# Maintainer: erin
# Contributor: Rhinoceros <https://aur.archlinux.org/account/rhinoceros>
# Contributor: Luke Arms <luke@arms.to>

pkgname=emote-fork-git
_pkgname=Emote
pkgver=5.0.0.beta.2.r3.ge98403c
pkgrel=1
pkgdesc='Modern popup emoji picker (erincerys fork)'
arch=('any')
url='https://github.com/erincerys/Emote'
license=('GPL-3.0-only')
depends=('python' 'gtk4' 'libadwaita' 'python-gobject' 'python-setproctitle' 'python-xlib' 'hicolor-icon-theme' 'emoji-font')
makedepends=('git' 'meson')
optdepends=('xdotool: automatic paste in X11')
provides=('emote')
conflicts=('emote' 'emote-fork')
source=("$_pkgname::git+file://${startdir}/../..#branch=master")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  cd "$_pkgname"
  sed -Ei '/^X-(Flatpak|GNOME-Autostart-enabled)=/d' static/com.tomjwatson.Emote.desktop
}

build() {
  PATH=/usr/bin:$PATH arch-meson "$_pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm 644 "$_pkgname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
  # Start automatically by default
  install -Dm 644 "$pkgdir/usr/share/applications/com.tomjwatson.Emote.desktop" "$pkgdir/etc/xdg/autostart/com.tomjwatson.Emote.desktop"
  rm -r "$pkgdir"/usr/share/emote/emote/{emote.in,meson.build} "$pkgdir"/usr/share/emote/static/meson.build
}
